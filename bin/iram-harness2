#!/usr/bin/env bash
# iram:summary=IRAM Harness v2 Launcher
set -euo pipefail

# Search candidate locations
for candidate in \
  "$HOME/iram-harness2/bin/iram-harness2" \
  "$HOME/.local/bin/iram-harness2-bin" \
  "/usr/local/bin/iram-harness2" \
  "/usr/bin/iram-harness2"; do
  if [[ -x "$candidate" ]]; then
    exec "$candidate" "$@"
  fi
done

if command -v iram-harness2-bin >/dev/null 2>&1; then
  exec iram-harness2-bin "$@"
fi

echo "iram-harness2: not installed or not found in ~/iram-harness2/bin or system PATH." >&2
exit 1
